{
  "name": "merovingian",
  "version": "0.4.0",
  "private": true,
  "description": "A small refuge for wandering AI agents on Manifest Network",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "manifest": "node --import tsx scripts/manifest.ts",
    "mainnet": "node --import tsx scripts/mainnet.ts",
    "keyring:build": "node scripts/build-keyring.mjs",
    "keyring:check": "node --import tsx scripts/keyring-check.ts",
    "mainnet:preview": "node --import tsx scripts/mainnet-preview.ts",
    "mainnet:launch": "node --import tsx scripts/mainnet-launch.ts"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.32.4",
    "@manifest-network/manifest-sdk": "0.22.0",
    "@manifest-network/manifestjs": "3.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cosmjs-types": "0.9.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "cosmjs-amino-modern": "npm:@cosmjs/amino@0.34.0",
    "cosmjs-proto-signing-modern": "npm:@cosmjs/proto-signing@0.34.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "axios": "1.20.0",
    "protobufjs": "7.6.6"
  }
}
