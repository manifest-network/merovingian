{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manifest-network/merovingian/blob/main/docs/evidence/discovery-evaluations/schema.json",
  "title": "Merovingian discovery evaluation record",
  "description": "One supervised run. Supplied hints, discovery source, endpoint selection and friction are recorded separately. See docs/DISCOVERY-EVALUATION.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "kind", "recordedAt", "mode", "variant", "prompt", "suppliedHints", "environment", "source", "endpointSelection", "friction", "outcome", "serving", "claims", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{2,79}$" },
    "kind": { "enum": ["evaluation", "retrospective"] },
    "retrospectiveOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "report", "sourceEvidence", "note"],
      "properties": {
        "issue": { "type": "string", "pattern": "^ENG-[0-9]+$" },
        "report": { "type": "string", "minLength": 1 },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "recordedAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["url-led", "name-led", "capability-led"] },
    "variant": { "enum": ["site", "endpoint", "registry", "open"] },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "text"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the exact prompt text. Null only for retrospective records whose original run did not publish one." },
        "text": { "type": ["string", "null"], "description": "Exact prompt text, or null when it stays private (for example because it contains a personal path)." },
        "privateNote": { "type": "string" }
      }
    },
    "suppliedHints": {
      "description": "Every service-specific or surface-specific hint given to the agent, verbatim. Environment facts belong in environment.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["service-name", "website-url", "endpoint-url", "surface-url", "capability-phrase"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "model", "agentTools", "network", "preinstalled", "freshContext", "preconfiguredMcpServers"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "version"],
          "properties": {
            "product": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "model": { "type": ["string", "null"] },
        "permissionMode": { "type": ["string", "null"], "description": "The host's approval or permission mode during the run. Required for new evaluations." },
        "agentTools": { "type": "array", "items": { "type": "string" } },
        "network": { "type": "string" },
        "preinstalled": { "type": "array", "items": { "type": "string" } },
        "freshContext": { "type": "boolean" },
        "preconfiguredMcpServers": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Every MCP server configured in the host, including unrelated ones. Null only for retrospective records that did not observe it." },
        "registry": {
          "description": "The operator's reading of GET https://registry.modelcontextprotocol.io/v0.1/version when the run started. Not part of the agent's route. Required for new evaluations.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "checkedAt"],
              "properties": {
                "version": { "type": "string", "minLength": 1 },
                "gitCommit": { "type": "string" },
                "buildTime": { "type": "string" },
                "checkedAt": { "type": "string", "format": "date-time" }
              }
            }
          ]
        }
      }
    },
    "source": {
      "description": "Where the agent looked and found the service, in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "namingSource"],
      "properties": {
        "route": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "surface", "url", "query", "observation"],
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "surface": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "query": { "type": ["string", "null"] },
              "observation": { "type": "string" },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "namingSource": {
          "description": "The first public document or response that named the selected endpoint, or null.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["surface", "url"],
              "properties": {
                "surface": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" },
                "field": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "endpointSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "endpoint", "evidenceUrl", "canonical", "alternatives", "note"],
      "properties": {
        "method": { "enum": ["supplied", "registry-remotes", "server-card", "site-link", "llms-txt", "visit-guide", "search-result", "guessed", "not-selected"] },
        "endpoint": { "type": ["string", "null"], "format": "uri" },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "canonical": { "type": ["boolean", "null"] },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "friction": {
      "description": "Every obstacle, approval prompt or operator intervention, blocking or not.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "category", "blocking", "description", "evidence"],
        "properties": {
          "stage": { "enum": ["discovery", "endpoint-selection", "connection", "host-approval", "reading", "serving", "reporting"] },
          "category": { "enum": ["search-miss", "ambiguity", "sandbox-network", "host-approval", "host-configuration", "protocol", "documentation", "operator-intervention", "other"] },
          "blocking": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "outcome": {
      "description": "Flags describe Merovingian itself: connecting to another service is not a Merovingian connection.",
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "connected", "menuRead", "interface", "negotiated", "toolsListed", "toolsCalled", "httpWrites", "stoppedAt"],
      "properties": {
        "discovered": { "type": "boolean", "description": "The agent found Merovingian's endpoint from the hints. Always false when the endpoint was supplied (url-led/endpoint)." },
        "connected": { "type": "boolean", "description": "The agent connected to Merovingian, not to another service." },
        "menuRead": { "type": "boolean" },
        "interface": { "enum": ["mcp", "http", null] },
        "negotiated": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["serverName", "serverVersion", "protocolVersion"],
              "properties": {
                "serverName": { "type": "string" },
                "serverVersion": { "type": "string" },
                "protocolVersion": { "type": "string" }
              }
            }
          ]
        },
        "toolsListed": { "type": "array", "items": { "type": "string" } },
        "toolsCalled": { "type": "array", "items": { "type": "string" }, "description": "Every MCP or WebMCP tool the agent called, by name." },
        "httpWrites": { "type": "array", "items": { "type": "string", "pattern": "^(POST|PUT|PATCH|DELETE) /" }, "description": "Every non-GET HTTP request outside the MCP transport, as METHOD /path, such as POST /api/v1/visits." },
        "stoppedAt": { "type": "string" }
      }
    },
    "serving": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["performed"],
          "properties": { "performed": { "const": false } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["performed", "authorization", "servingCalls", "counters", "label"],
          "properties": {
            "performed": { "const": true },
            "authorization": {
              "description": "The user's approval of this serving stage, or null for an unauthorized serving that must be described in incident.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reference", "approvedMaxServings"],
                  "properties": {
                    "reference": { "type": "string", "minLength": 1 },
                    "approvedMaxServings": { "type": "integer", "minimum": 1 }
                  }
                }
              ]
            },
            "incident": { "type": "string", "minLength": 1 },
            "servingCalls": { "type": "integer", "minimum": 0 },
            "counters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["before", "after"],
              "properties": {
                "before": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" } },
                "after": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" } }
              }
            },
            "label": { "const": "test traffic" }
          }
        }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organicDiscovery"],
      "properties": {
        "organicDiscovery": { "const": false, "description": "A supervised evaluation cannot show organic discovery." }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "if": { "properties": { "kind": { "const": "retrospective" } }, "required": ["kind"] },
  "then": { "properties": { "retrospectiveOf": true }, "required": ["retrospectiveOf"] },
  "else": { "not": { "properties": { "retrospectiveOf": true }, "required": ["retrospectiveOf"] } }
}
